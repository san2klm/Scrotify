<?xml version="1.0" encoding="utf-8"?>
<!-- Personalizable (estilo AIMP, 3x1): portada a la izquierda; título,
     "Artista - Álbum" y controles (anterior, play, siguiente, favorito) a la
     derecha; engranaje para elegir colores. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_round"
        android:tint="#FF121212" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_cover_description"
            android:maxWidth="96dp"
            android:maxHeight="96dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginEnd="26dp"
                    android:text="@string/widget_nothing_playing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_open_app"
                android:textColor="#FFB3B3B3"
                android:textSize="9.5sp" />

            <!-- Separador flexible (un <View> no está permitido en RemoteViews). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_previous"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_chevron_left" />

                <ImageButton
                    android:id="@+id/widget_play"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_play_pause"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play_ring" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_next"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_chevron_right" />

                <ImageButton
                    android:id="@+id/widget_like"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_like"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_heart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- Engranaje superpuesto: zona de toque de 40dp sin ocupar alto en la fila. -->
    <ImageButton
        android:id="@+id/widget_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_settings"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_settings" />
</FrameLayout>
