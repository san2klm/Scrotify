<?xml version="1.0" encoding="utf-8"?>
<!-- Banner horizontal de 320x180 para el launcher de Android TV / Google TV -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF121212" />
        </shape>
    </item>
    <!-- Fondo decorativo sutil -->
    <item
        android:width="280dp"
        android:height="140dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FF181818"
                android:endColor="#FF282828"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FF333333" />
        </shape>
    </item>
    <!-- Ícono / Emblema Scrotify -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center_vertical"
        android:left="32dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1DB954" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center_vertical"
        android:left="48dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
