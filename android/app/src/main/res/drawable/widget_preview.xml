<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa estática para el selector de widgets: no depende de que el
     lanzador sepa inflar el layout real (algunos muestran un rectángulo negro). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1B1B1B" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FF3A3A3A" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="start|center_vertical"
        android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1DB954" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="10dp"
        android:gravity="start|center_vertical"
        android:left="96dp"
        android:top="-26dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item
        android:width="100dp"
        android:height="8dp"
        android:gravity="start|center_vertical"
        android:left="96dp"
        android:top="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="start|center_vertical"
        android:left="124dp"
        android:top="30dp"
        android:drawable="@drawable/ic_widget_play" />
</layer-list>
