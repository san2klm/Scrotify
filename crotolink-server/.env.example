# Puerto HTTP/WebSocket interno del contenedor.
PORT=8080

# Carpeta de datos (base SQLite). En Docker es el volumen /data.
DATA_DIR=/data

# Contraseña del panel /admin (mínimo 8 caracteres). Solo se usa en el primer
# arranque: después se guarda su hash y esta variable se puede borrar. Si se
# deja vacía, el servidor imprime en el registro un token de configuración.
ADMIN_PASSWORD=

# URL pública del servidor (https://…), para enlaces de invitación.
PUBLIC_URL=

# Cabeceras de proxy que se respetan para conocer la IP del cliente:
# none (defecto) | cloudflare (CF-Connecting-IP) | forwarded (X-Forwarded-For).
# Solo se aceptan si la conexión llega desde loopback o red privada.
TRUST_PROXY=none

# Código fuente de TU versión si la modificas (AGPL-3.0 §13).
SOURCE_URL=

# Límites defensivos del servidor.
MAX_MESSAGE_BYTES=16384
MAX_PARTICIPANTS=50
ROOM_IDLE_MS=3600000
