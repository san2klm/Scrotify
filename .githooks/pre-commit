#!/usr/bin/env bash
# Frena commits con claves de firma o secretos (ver docs/SIGNING.md).
# Activar una vez por clon:  git config core.hooksPath .githooks
# Si gitleaks está instalado, además pasa su análisis sobre lo preparado.
set -euo pipefail

bad=0
names='\.(jks|keystore|pfx|p12|pem|key|asc|sig)$|(^|/)key\.properties$|(^|/)\.?signing/|(^|/)cosign\.key$|(^|/)migration-backup/'
while IFS= read -r -d '' f; do
  if [[ $f =~ $names ]]; then
    echo "pre-commit: «$f» parece una clave o un secreto; no se sube." >&2
    bad=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# Contenido: claves privadas y contraseñas de keystore en cualquier archivo.
# Los marcadores de ejemplo de la documentación (`=…`, `=<…>`) no cuentan.
if git diff --cached -U0 --diff-filter=ACMR |
   grep -E -- '^\+(.*-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|(storePassword|keyPassword)=[^[:space:]…<])' >/dev/null; then
  echo "pre-commit: lo preparado contiene una clave privada o una contraseña de keystore." >&2
  bad=1
fi

if (( bad == 0 )) && command -v gitleaks >/dev/null; then
  gitleaks git --staged --no-banner --redact || bad=1
fi

if (( bad )); then
  echo "Commit cancelado. Si es un falso positivo: git commit --no-verify" >&2
  exit 1
fi
